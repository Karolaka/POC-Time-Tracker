@page "/final-approvals"
@attribute [Authorize(Roles = "FinalApprover")]
@implements IDisposable
@inject InMemoryTimesheetStore Store
@inject FakeAuthenticationStateProvider AuthProvider

<div class="page-header">
    <h3>Final Approvals</h3>
    <p class="page-subtitle">Second-stage sign-off across all organizations for timesheets already approved by a first-stage program approver.</p>
</div>

<div class="surface-card" style="padding:0;">
<TelerikGrid Data="@PendingFinalApproval" Pageable="true" Sortable="true" FilterMode="@GridFilterMode.FilterRow">
    <GridColumns>
        <GridColumn Field="@nameof(TimesheetWeek.Organization)" Title="Organization" Width="140px" />
        <GridColumn Field="@nameof(TimesheetWeek.UserId)" Title="User" />
        <GridColumn Field="@nameof(TimesheetWeek.WeekStarting)" Title="Week" Width="130px" />
        <GridColumn Field="@nameof(TimesheetWeek.ApprovedByUserId)" Title="First-Stage Approver" Width="180px" />
        <GridColumn Field="@nameof(TimesheetWeek.Status)" Title="Status" Width="150px">
            <Template>
                @{ var ts = (TimesheetWeek)context; }
                <span class="badge-soft badge-soft-blue">@ts.Status</span>
            </Template>
        </GridColumn>
        <GridCommandColumn>
            <GridCommandButton OnClick="@(() => FinalApprove(context))" ThemeColor="primary" Class="btn-approve">Final Approve</GridCommandButton>
            <GridCommandButton OnClick="@(() => Reject(context))" FillMode="flat" Class="btn-reject">Reject</GridCommandButton>
        </GridCommandColumn>
    </GridColumns>
</TelerikGrid>
</div>

@code {
    private List<TimesheetWeek> PendingFinalApproval { get; set; } = [];

    protected override void OnInitialized()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        RefreshQueue();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(() =>
        {
            RefreshQueue();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void RefreshQueue()
    {
        PendingFinalApproval = Store.GetFinalApprovableTimesheets().ToList();
    }

    private void FinalApprove(object context)
    {
        var ts = (TimesheetWeek)context;
        ts.Status = TimesheetStatus.Approved;
        ts.FinalApprovedByUserId = AuthProvider.CurrentUser?.Id;
        Store.SaveTimesheets();
        RefreshQueue();
    }

    private void Reject(object context)
    {
        var ts = (TimesheetWeek)context;
        ts.Status = TimesheetStatus.Rejected;
        Store.SaveTimesheets();
        RefreshQueue();
    }
}
