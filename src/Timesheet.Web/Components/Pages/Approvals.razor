@page "/approvals"
@attribute [Authorize(Roles = "Approver")]
@implements IDisposable
@inject InMemoryTimesheetStore Store
@inject FakeAuthenticationStateProvider AuthProvider

<div class="page-header">
    <h3>Approvals</h3>
    <p class="page-subtitle">Program-centric approval workspace. Approving a timesheet moves it to first-stage approved, pending final sign-off by a super admin.</p>
</div>

<div class="kpi-row">
    <div class="kpi-card">
        <span class="kpi-label">Pending Timesheets</span>
        <span class="kpi-value">@ApprovableTimesheets.Count</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Total Hours Pending</span>
        <span class="kpi-value">@TotalHoursPending.ToString("0.##")<span class="kpi-meta"> h</span></span>
    </div>
</div>

@if (ProgramGroups.Count == 0)
{
    <div class="surface-card text-center">
        <p class="mb-0 text-muted">No timesheets pending approval right now.</p>
    </div>
}
else
{
    <div class="program-panelbar">
        @foreach (var group in ProgramGroups)
        {
            <div class="k-panelbar-item @UiHelpers.GetOrgAccentClass(group.Organization)">
                <div class="k-panelbar-header">
                    <div class="k-link">
                        <div class="program-header">
                            <div class="program-header-title">
                                <span class="program-name">Program: @group.ProgramName</span>
                                <span class="badge-soft @UiHelpers.GetOrgBadgeClass(group.Organization)">@group.Organization</span>
                            </div>
                            <div class="program-header-stats">
                                <div class="program-stat">
                                    <span class="program-stat-value">@group.PendingCount</span>
                                    <span class="program-stat-label">Pending Timesheets</span>
                                </div>
                                <div class="program-stat">
                                    <span class="program-stat-value">@group.PendingHours.ToString("0.##")h</span>
                                    <span class="program-stat-label">Pending Hours</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="k-panelbar-content">
                    @foreach (var ts in group.Timesheets)
                    {
                        <div class="timesheet-card">
                            <div class="timesheet-card-info">
                                <span class="timesheet-card-user">@Store.GetUserDisplayName(ts.UserId)</span>
                                <span class="timesheet-card-meta">Week: @ts.WeekStarting.ToString("MM/dd/yyyy")</span>
                                <span class="timesheet-card-meta">
                                    <span class="badge-soft badge-soft-blue">@ts.Status</span>
                                </span>
                            </div>
                            <div class="timesheet-card-projects">
                                <span class="timesheet-card-projects-title">Projects</span>
                                @foreach (var line in Store.GetProjectHoursLines(ts))
                                {
                                    <div class="project-line">
                                        <span class="project-line-name">&bull; @line.ProjectName</span>
                                        <span class="project-line-hours">@line.Hours.ToString("0.##")h</span>
                                    </div>
                                }
                            </div>
                            <div class="timesheet-card-actions">
                                <div class="timesheet-card-total">
                                    <div class="total-value">@InMemoryTimesheetStore.GetTotalHours(ts).ToString("0.##")h</div>
                                    <div class="total-label">Total Hours</div>
                                </div>
                                <div class="timesheet-card-buttons">
                                    <TelerikButton OnClick="@(() => Approve(ts))" ThemeColor="primary" Class="btn-approve">Approve</TelerikButton>
                                    <TelerikButton OnClick="@(() => Reject(ts))" FillMode="flat" Class="btn-reject">Reject</TelerikButton>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<TimesheetWeek> ApprovableTimesheets { get; set; } = [];
    private List<ProgramApprovalGroup> ProgramGroups { get; set; } = [];
    private decimal TotalHoursPending => ApprovableTimesheets.Sum(InMemoryTimesheetStore.GetTotalHours);

    private bool _disposed;

    protected override void OnInitialized()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        RefreshQueue();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        if (_disposed) return;

        await InvokeAsync(() =>
        {
            if (_disposed) return;
            RefreshQueue();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void RefreshQueue()
    {
        var approver = AuthProvider.CurrentUser;
        ApprovableTimesheets = approver is null
            ? []
            : Store.GetApprovableTimesheets(approver)
                .Where(t => t.Status == TimesheetStatus.Submitted)
                .ToList();

        ProgramGroups = Store.GroupByProgram(ApprovableTimesheets);
    }

    private void Approve(TimesheetWeek ts)
    {
        ts.Status = TimesheetStatus.FirstStageApproved;
        ts.ApprovedByUserId = AuthProvider.CurrentUser?.Id;
        Store.SaveTimesheets();
        RefreshQueue();
    }

    private void Reject(TimesheetWeek ts)
    {
        ts.Status = TimesheetStatus.Rejected;
        Store.SaveTimesheets();
        RefreshQueue();
    }
}
