@page "/approvals"
@attribute [Authorize(Roles = "Approver")]
@implements IDisposable
@inject InMemoryTimesheetStore Store
@inject FakeAuthenticationStateProvider AuthProvider

<div class="page-header">
    <h3>Approvals</h3>
    <p class="page-subtitle">Showing timesheets across your approval scope (may span multiple delivery partners). Approving here moves a timesheet to first-stage approved, pending final sign-off by a super admin.</p>
</div>

<div class="kpi-row">
    <div class="kpi-card">
        <span class="kpi-label">Pending Timesheets</span>
        <span class="kpi-value">@ApprovableTimesheets.Count</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Total Hours Pending</span>
        <span class="kpi-value">@TotalHoursPending.ToString("0.##")<span class="kpi-meta"> h</span></span>
    </div>
</div>

<div class="surface-card" style="padding:0;">
<TelerikGrid Data="@ApprovableTimesheets" Pageable="true" Sortable="true" FilterMode="@GridFilterMode.FilterRow">
    <GridColumns>
        <GridColumn Field="@nameof(TimesheetWeek.Organization)" Title="Organization" Width="140px" />
        <GridColumn Title="User" Width="160px">
            <Template>
                @{ var ts = (TimesheetWeek)context; }
                @Store.GetUserDisplayName(ts.UserId)
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(TimesheetWeek.WeekStarting)" Title="Week" Width="130px" />
        <GridColumn Title="Project Hours" MinResizableWidth="220">
            <Template>
                @{ var ts = (TimesheetWeek)context; }
                <span style="font-size:0.85rem;">@Store.GetProjectHoursBreakdown(ts)</span>
            </Template>
        </GridColumn>
        <GridColumn Title="Total Hours" Width="120px">
            <Template>
                @{ var ts = (TimesheetWeek)context; }
                <strong>@InMemoryTimesheetStore.GetTotalHours(ts).ToString("0.##")</strong>
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(TimesheetWeek.Status)" Title="Status" Width="130px">
            <Template>
                @{ var ts = (TimesheetWeek)context; }
                <span class="badge-soft badge-soft-blue">@ts.Status</span>
            </Template>
        </GridColumn>
        <GridCommandColumn>
            <GridCommandButton OnClick="@(() => Approve(context))" ThemeColor="primary" Class="btn-approve">Approve</GridCommandButton>
            <GridCommandButton OnClick="@(() => Reject(context))" FillMode="flat" Class="btn-reject">Reject</GridCommandButton>
        </GridCommandColumn>
    </GridColumns>
</TelerikGrid>
</div>

@code {
    private List<TimesheetWeek> ApprovableTimesheets { get; set; } = [];
    private decimal TotalHoursPending => ApprovableTimesheets.Sum(InMemoryTimesheetStore.GetTotalHours);

    protected override void OnInitialized()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        RefreshQueue();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(() =>
        {
            RefreshQueue();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void RefreshQueue()
    {
        var approver = AuthProvider.CurrentUser;
        ApprovableTimesheets = approver is null
            ? []
            : Store.GetApprovableTimesheets(approver)
                .Where(t => t.Status == TimesheetStatus.Submitted)
                .ToList();
    }

    private void Approve(object context)
    {
        var ts = (TimesheetWeek)context;
        ts.Status = TimesheetStatus.FirstStageApproved;
        ts.ApprovedByUserId = AuthProvider.CurrentUser?.Id;
        Store.SaveTimesheets();
        RefreshQueue();
    }

    private void Reject(object context)
    {
        var ts = (TimesheetWeek)context;
        ts.Status = TimesheetStatus.Rejected;
        Store.SaveTimesheets();
        RefreshQueue();
    }
}
