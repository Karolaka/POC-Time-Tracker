@inject FakeAuthenticationStateProvider AuthProvider
@inject InMemoryTimesheetStore Store

<div class="d-flex align-items-center px-3 py-2 gap-2">
    <label class="me-2 mb-0 text-muted" style="font-size:0.85rem;">Sign in as</label>
    <TelerikDropDownList Data="@Store.Users"
                         @bind-Value="@SelectedUserId"
                         @bind-Value:after="@OnUserChanged"
                         TextField="@nameof(AppUser.DisplayName)"
                         ValueField="@nameof(AppUser.Id)"
                         DefaultText="Select user..."
                         Width="240px" />
    @if (AuthProvider.CurrentUser is not null)
    {
        <span class="badge-soft badge-soft-neutral ms-2">
            @AuthProvider.CurrentUser.Organization &middot; @string.Join(", ", AuthProvider.CurrentUser.Roles)
        </span>
    }
</div>

@code {
    private string? SelectedUserId { get; set; }

    private void OnUserChanged()
    {
        var user = Store.Users.FirstOrDefault(u => u.Id == SelectedUserId);
        if (user is not null)
        {
            AuthProvider.SignInAs(user);
        }
    }
}
